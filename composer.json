{
    "name": "morsalin1342/caddy-souin-cache-manager",
    "description": "Manage Souin cache for Caddy server within WP Admin. View cache keys and purge cache.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "version": "1.8.15",
    "authors": [
        {
            "name": "MD Morsalin",
            "email": "contact@morsalin.online"
        }
    ],
    "autoload": {
        "psr-4": {
            "morsalin1342\\CaddySouinCacheManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/unit/"
        }
    },
    "require": {
        "php": ">=8.1",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-xml": "*",
        "ext-xmlwriter": "*",
        "predis/predis": "^3.4"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src tests caddy-souin-cache-manager.php -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    }
}
